  "Matt.1.20": {
    "hasFronting": true,
    "clauses": [
      {
        "pattern": "EMPHATIC",
        "frontedElement": "αὐτὸς",
        "frontedRole": "pronoun",
        "greekText": "ταῦτα αὐτοῦ ἐνθυμηθέντος ἰδοὺ ἄγγελος Κυρίου κατ’ ὄναρ ἐφάνη αὐτῷ λέγων Ἰωσὴφ υἱὸς Δαυείδ μὴ φοβηθῇς παραλαβεῖν Μαρίαν τὴν γυναῖκά σου γὰρ τὸ ἐν αὐτῇ γεννηθὲν ἐκ Πνεύματός Ἁγίου· ἐστιν δὲ τέξεται υἱὸν καὶ καλέσεις τὸ ὄνομα αὐτοῦ Ἰησοῦν· γὰρ αὐτὸς σώσει τὸν λαὸν αὐτοῦ ἀπὸ τῶν ἁμαρτιῶν αὐτῶν",
        "note": "Emphatic pronoun αὐτὸς explicitly stated when not grammatically required - emphasizes the subject",
        "clauseNumber": 1,
        "frontedElementGloss": "the/this/who"
      },
      {
        "pattern": "O-S-V",
        "frontedElement": "ταῦτα",
        "frontedRole": "object",
        "greekText": "ταῦτα αὐτοῦ ἐνθυμηθέντος",
        "note": "Object fronted to clause-initial position - strong emphasis on object",
        "clauseNumber": 2,
        "frontedElementGloss": "this/he/she/it"
      },
      {
        "pattern": "EMPHATIC",
        "frontedElement": "αὐτὸς",
        "frontedRole": "pronoun",
        "greekText": "λέγων Ἰωσὴφ υἱὸς Δαυείδ μὴ φοβηθῇς παραλαβεῖν Μαρίαν τὴν γυναῖκά σου γὰρ τὸ ἐν αὐτῇ γεννηθὲν ἐκ Πνεύματός Ἁγίου· ἐστιν δὲ τέξεται υἱὸν καὶ καλέσεις τὸ ὄνομα αὐτοῦ Ἰησοῦν· γὰρ αὐτὸς σώσει τὸν λαὸν αὐτοῦ ἀπὸ τῶν ἁμαρτιῶν αὐτῶν",
        "note": "Emphatic pronoun αὐτὸς explicitly stated when not grammatically required - emphasizes the subject",
        "clauseNumber": 3,
        "frontedElementGloss": "the/this/who"
      },
      {
        "pattern": "EMPHATIC",
        "frontedElement": "αὐτὸς",
        "frontedRole": "pronoun",
        "greekText": "καλέσεις τὸ ὄνομα αὐτοῦ Ἰησοῦν· γὰρ αὐτὸς σώσει τὸν λαὸν αὐτοῦ ἀπὸ τῶν ἁμαρτιῶν αὐτῶν",
        "note": "Emphatic pronoun αὐτὸς explicitly stated when not grammatically required - emphasizes the subject",
        "clauseNumber": 9,
        "frontedElementGloss": "the/this/who"
      },
      {
        "pattern": "EMPHATIC",
        "frontedElement": "αὐτὸς",
        "frontedRole": "pronoun",
        "greekText": "αὐτὸς σώσει τὸν λαὸν αὐτοῦ ἀπὸ τῶν ἁμαρτιῶν αὐτῶν",
        "note": "Emphatic pronoun αὐτὸς explicitly stated when not grammatically required - emphasizes the subject",

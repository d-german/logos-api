{
  "openapi": "3.1.0",
  "info": {
    "title": "Logos Bible API",
    "description": "API for looking up Bible verses with Greek/Hebrew linguistic data, lexicon definitions, semantic domain search, and commentary from multiple sources.",
    "version": "1.8.0"
  },
  "servers": [{"url": "https://wispy-koi-d-german-8684f0e9.koyeb.app"}],
  "paths": {
    "/api/verses/lookup": {
      "get": {
        "operationId": "lookupVerses",
        "summary": "Look up Bible verses with linguistic data",
        "description": "Retrieves verses with Greek text, Strong's numbers, morphology. Supports RANGES (Matt.1.1-4 expands to individual verses). Formats: Matt.1.1, Matthew 1:1, Mt 1:1.",
        "parameters": [{
          "name": "verseReferences",
          "in": "query",
          "required": true,
          "description": "Verse references. Supports RANGES (Matt.1.1-4). Format: Book.Chapter.Verse or Book.Chapter.Start-End",
          "schema": {"type": "array", "items": {"type": "string"}, "example": ["Matt.1.1-4", "John.3.16"]}
        }],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/VerseLookupResult"}
              }
            }
          }
        }
      }
    },
    "/api/lexicon/{strongsNumber}": {
      "get": {
        "operationId": "getLexiconEntry",
        "summary": "Look up a lexicon entry",
        "parameters": [{
          "name": "strongsNumber",
          "in": "path",
          "required": true,
          "schema": {"type": "string", "example": "G25"}
        }],
        "responses": {
          "200": {"description": "Success", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LexiconLookupResponse"}}}},
          "400": {"description": "Invalid format", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "404": {"description": "Not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/api/semantic-domain/domains": {
      "get": {
        "operationId": "getAvailableDomains",
        "summary": "Get all available semantic domain numbers",
        "description": "Returns a list of all major Louw-Nida semantic domain numbers (1-93) available in the data.",
        "responses": {
          "200": {"description": "List of domain numbers", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "integer"}, "example": [1, 2, 33, 57, 93]}}}}
        }
      }
    },
    "/api/semantic-domain/{majorDomain}": {
      "get": {
        "operationId": "getWordsByDomain",
        "summary": "Get all words in a semantic domain",
        "description": "Returns all Greek words in a Louw-Nida major semantic domain with sample verse references. Use domain 57 for economic terms, 33 for communication, etc.",
        "parameters": [
          {"name": "majorDomain", "in": "path", "required": true, "description": "Major domain number (1-93)", "schema": {"type": "integer", "example": 57}},
          {"name": "maxVersesPerWord", "in": "query", "required": false, "description": "Maximum sample verses per word (default: 3)", "schema": {"type": "integer", "default": 3, "example": 3}}
        ],
        "responses": {
          "200": {"description": "Domain search result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DomainSearchResult"}}}},
          "404": {"description": "Domain not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/api/semantic-domain/related": {
      "get": {
        "operationId": "getRelatedWords",
        "summary": "Get words related by Louw-Nida semantic domain",
        "description": "Given a Louw-Nida number (e.g., 57.235), finds other words in the same major domain. Useful for finding semantically related Greek words.",
        "parameters": [
          {"name": "louwNida", "in": "query", "required": true, "description": "Louw-Nida reference number (e.g., 57.235)", "schema": {"type": "string", "example": "57.235"}},
          {"name": "limit", "in": "query", "required": false, "description": "Maximum related words to return (default: 10)", "schema": {"type": "integer", "default": 10, "example": 10}},
          {"name": "maxVersesPerWord", "in": "query", "required": false, "description": "Maximum sample verses per word (default: 3)", "schema": {"type": "integer", "default": 3, "example": 3}}
        ],
        "responses": {
          "200": {"description": "Related words result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RelatedWordsResult"}}}},
          "400": {"description": "Missing louwNida parameter", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "404": {"description": "Louw-Nida number not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/api/commentary/all": {
      "get": {
        "operationId": "getAllCommentaries",
        "summary": "Get commentary from ALL sources for multiple verses",
        "description": "Commentary from all sources. Supports verse RANGES (Matt.1.1-4). Only sources with content returned.",
        "parameters": [{
          "name": "verseReferences",
          "in": "query",
          "required": true,
          "description": "Verse references. Supports RANGES (Matt.1.1-4).",
          "schema": {"type": "array", "items": {"type": "string"}, "example": ["John.1.1-3", "Rom.8.28"]}
        }],
        "responses": {
          "200": {"description": "Commentary from all sources", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AllCommentariesLookupResponse"}}}},
          "400": {"description": "Invalid reference format", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/api/commentary/{commentaryId}/{reference}": {
      "get": {
        "operationId": "getCommentary",
        "summary": "Get commentary for a verse from a specific source",
        "description": "Retrieves commentary for a specific verse from the specified commentary source. Multiple reference formats accepted: John.1.3, Jn 1:3, John 1:3, etc.",
        "parameters": [
          {
            "name": "commentaryId",
            "in": "path",
            "required": true,
            "description": "Commentary ID: tyndale, john-gill, matthew-henry, adam-clarke, jamieson-fausset-brown, keil-delitzsch",
            "schema": {"type": "string", "example": "tyndale"}
          },
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "description": "Verse reference. Multiple formats accepted: John.1.3, Jn 1:3, John 1:3. For ranges, use the /api/commentary/all endpoint instead.",
            "schema": {"type": "string", "example": "John.1.3"}
          }
        ],
        "responses": {
          "200": {"description": "Commentary found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommentaryLookupResponse"}}}},
          "400": {"description": "Invalid reference format", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "404": {"description": "Commentary not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/health": {"get": {"operationId": "healthCheck", "responses": {"200": {"description": "Healthy", "content": {"text/plain": {"schema": {"type": "string"}}}}}}}
  },
  "components": {
    "schemas": {
      "VerseLookupResult": {
        "type": "object",
        "properties": {
          "verses": {"type": "array", "items": {"$ref": "#/components/schemas/VerseResponse"}},
          "notFound": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["verses", "notFound"]
      },
      "VerseResponse": {
        "type": "object",
        "properties": {
          "reference": {"type": "string"},
          "tokens": {"type": "array", "items": {"$ref": "#/components/schemas/TokenResponse"}}
        },
        "required": ["reference", "tokens"]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "gloss": {"type": "string", "description": "English translation/meaning"},
          "greek": {"type": "string", "description": "Original Greek text"},
          "translit": {"type": "string", "description": "Transliteration"},
          "strongs": {"type": "string", "description": "Strong's number (e.g., G976)"},
          "rmac": {"type": "string", "description": "Robinson's Morphological Analysis Code"},
          "rmacDesc": {"type": "string", "description": "Human-readable morphology description"},
          "morph": {"$ref": "#/components/schemas/MorphologyInfo"},
          "strongDef": {"type": "string", "description": "Strong's definition of the word"}
        },
        "required": ["gloss", "greek", "translit", "strongs", "rmac"]
      },
      "MorphologyInfo": {
        "type": "object",
        "description": "Parsed morphological components from RMAC code. Only non-null fields are included.",
        "properties": {
          "pos": {"type": "string", "description": "Part of speech"},
          "tense": {"type": "string", "description": "Verb tense"},
          "voice": {"type": "string", "description": "Verb voice"},
          "verbForm": {"type": "string", "description": "Verb form: Finite, Participle, or Infinitive"},
          "mood": {"type": "string", "description": "Finite verb mood only"},
          "case": {"type": "string", "description": "Grammatical case"},
          "number": {"type": "string", "description": "Number: Singular, Plural"},
          "gender": {"type": "string", "description": "Gender: Masculine, Feminine, Neuter"},
          "person": {"type": "string", "description": "Person: First, Second, Third"},
          "flags": {"type": "array", "items": {"type": "string"}, "description": "Additional flags"}
        }
      },
      "LexiconLookupResponse": {
        "type": "object",
        "properties": {
          "strongsNumber": {"type": "string"},
          "definition": {"type": "string"}
        },
        "required": ["strongsNumber", "definition"]
      },
      "DomainSearchResult": {
        "type": "object",
        "description": "Result of a semantic domain search",
        "properties": {
          "majorDomain": {"type": "integer", "description": "Major Louw-Nida domain number"},
          "domainLabel": {"type": "string", "description": "Human-readable domain label (e.g., 'Possess, Transfer, Exchange')"},
          "totalEntries": {"type": "integer", "description": "Number of word entries in this domain"},
          "entries": {"type": "array", "items": {"$ref": "#/components/schemas/DomainEntry"}}
        },
        "required": ["majorDomain", "domainLabel", "totalEntries", "entries"]
      },
      "DomainEntry": {
        "type": "object",
        "description": "A word entry in a semantic domain",
        "properties": {
          "subdomain": {"type": "string", "description": "Subdomain number within major domain"},
          "subdomainLabel": {"type": "string", "description": "Human-readable subdomain label"},
          "louwNida": {"type": "string", "description": "Full L-N reference (e.g., '57.235')"},
          "lemma": {"type": "string", "description": "Greek dictionary form"},
          "gloss": {"type": "string", "description": "English translation"},
          "strongs": {"type": "string", "description": "Strong's number"},
          "frequency": {"type": "integer", "description": "Occurrences in NT"},
          "isHapax": {"type": "boolean", "description": "True if occurs only once"},
          "sampleVerses": {"type": "array", "items": {"type": "string"}, "description": "Sample verse references"}
        },
        "required": ["subdomain", "louwNida", "lemma", "gloss", "strongs", "frequency", "isHapax", "sampleVerses"]
      },
      "RelatedWordsResult": {
        "type": "object",
        "description": "Words semantically related by Louw-Nida domain",
        "properties": {
          "sourceLouwNida": {"type": "string", "description": "Source L-N number used for lookup"},
          "sourceLemma": {"type": "string", "description": "Lemma of source word"},
          "majorDomain": {"type": "integer", "description": "Major domain number"},
          "domainLabel": {"type": "string", "description": "Domain label"},
          "relatedWords": {"type": "array", "items": {"$ref": "#/components/schemas/DomainEntry"}}
        },
        "required": ["sourceLouwNida", "sourceLemma", "majorDomain", "domainLabel", "relatedWords"]
      },
      "CommentaryLookupResponse": {
        "type": "object",
        "properties": {
          "reference": {"type": "string", "description": "The verse reference"},
          "commentaryId": {"type": "string", "description": "Commentary source ID"},
          "commentaryName": {"type": "string", "description": "Commentary source name"},
          "verses": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/VerseCommentary"}
          },
          "notFound": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["reference", "commentaryId", "commentaryName", "verses", "notFound"]
      },
      "AllCommentariesLookupResponse": {
        "type": "object",
        "description": "Commentary from all available sources for multiple verses. Only commentaries with content are included.",
        "properties": {
          "references": {"type": "array", "items": {"type": "string"}, "description": "The requested verse references"},
          "commentaries": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/CommentaryResult"},
            "description": "Commentary from each source that has content"
          },
          "notFound": {"type": "array", "items": {"type": "string"}, "description": "References with no commentary in any source"}
        },
        "required": ["references", "commentaries", "notFound"]
      },
      "CommentaryResult": {
        "type": "object",
        "description": "Commentary results from a single source",
        "properties": {
          "commentaryId": {"type": "string"},
          "commentaryName": {"type": "string"},
          "entries": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/VerseCommentaryEntry"}
          }
        },
        "required": ["commentaryId", "commentaryName", "entries"]
      },
      "VerseCommentaryEntry": {
        "type": "object",
        "properties": {
          "reference": {"type": "string"},
          "verseNumber": {"type": "integer"},
          "content": {"type": "string", "description": "Commentary text"}
        },
        "required": ["reference", "verseNumber", "content"]
      },
      "VerseCommentary": {
        "type": "object",
        "properties": {
          "verseNumber": {"type": "integer"},
          "content": {"type": "string", "description": "Commentary text"}
        },
        "required": ["verseNumber", "content"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {"type": "string"}
        },
        "required": ["error"]
      }
    }
  }
}
